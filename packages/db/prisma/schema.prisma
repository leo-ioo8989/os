generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ObjectiveStatus {
  DRAFT
  PLANNING
  READY
  RUNNING
  WAITING_APPROVAL
  BLOCKED
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskLevel {
  GREEN
  YELLOW
  RED
}

enum TaskStatus {
  PENDING
  READY
  RUNNING
  WAITING_APPROVAL
  BLOCKED
  FAILED
  COMPLETED
  CANCELLED
}

enum Role {
  FOUNDER
  ADMIN
  OPERATOR
  VIEWER
}

enum ActorType {
  USER
  AGENT
  SYSTEM
}

enum AuditResult {
  SUCCESS
  FAILURE
  DENIED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum WorkflowStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  PAUSED
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum JobStatus {
  QUEUED
  CLAIMED
  RUNNING
  WAITING_APPROVAL
  RETRY_QUEUED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum WorkerStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  objectives  Objective[]
  memberships Membership[]
  auditEvents AuditEvent[]
  approvals   Approval[]
  workflows   Workflow[]
  jobs        Job[]
  checkpoints Checkpoint[]
  workers     Worker[]
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  displayName       String?
  passwordHash      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  memberships       Membership[]
  sessions          Session[]
  auditEvents       AuditEvent[]
  requestedApprovals Approval[] @relation("ApprovalRequester")
  decidedApprovals  Approval[] @relation("ApprovalDecider")
}

model Membership {
  userId         String
  organizationId String
  role           Role   @default(VIEWER)
  createdAt      DateTime @default(now())
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId, role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Objective {
  id            String          @id @default(cuid())
  organizationId String
  title         String
  description   String
  projectId     String?
  createdBy     String
  priority      Priority
  status        ObjectiveStatus @default(DRAFT)
  riskLevel     RiskLevel       @default(GREEN)
  budget        Decimal?        @db.Decimal(18, 6)
  estimatedCost Decimal?        @db.Decimal(18, 6)
  actualCost    Decimal         @default(0) @db.Decimal(18, 6)
  successCriteria Json
  deadline      DateTime?
  createdAt     DateTime        @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  currentPhase  String?
  metadata      Json
  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tasks         Task[]
  jobs          Job[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([deadline])
}

model Task {
  id              String     @id @default(cuid())
  objectiveId     String
  title           String
  description     String
  status          TaskStatus @default(PENDING)
  assignedAgentId String?
  riskLevel       RiskLevel  @default(GREEN)
  estimatedCost   Decimal?   @db.Decimal(18, 6)
  actualCost      Decimal    @default(0) @db.Decimal(18, 6)
  retryCount      Int        @default(0)
  retryLimit      Int        @default(3)
  metadata        Json
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  objective       Objective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  dependencies    TaskDependency[] @relation("taskDependencies")
  dependents      TaskDependency[] @relation("taskDependents")
  jobs            Job[]

  @@index([objectiveId, status])
  @@index([assignedAgentId, status])
}

model TaskDependency {
  taskId       String
  dependencyId String
  createdAt    DateTime @default(now())
  task         Task     @relation("taskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependency   Task     @relation("taskDependents", fields: [dependencyId], references: [id], onDelete: Cascade)

  @@id([taskId, dependencyId])
  @@index([dependencyId])
}

model AuditEvent {
  id             String      @id @default(cuid())
  organizationId String
  actorId        String?
  actorType      ActorType
  eventType      String
  resourceType   String?
  resourceId     String?
  action         String
  result         AuditResult
  metadata       Json
  createdAt      DateTime    @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId, createdAt])
  @@index([actorId, createdAt])
  @@index([eventType, createdAt])
}

model Approval {
  id                 String         @id @default(cuid())
  organizationId    String
  requesterId        String?
  requesterAgentId   String?
  targetResourceType String?
  targetResourceId   String?
  action             String
  actionFingerprint  String
  policyVersion      String
  riskLevel          RiskLevel
  reason             String
  evidence           Json
  estimatedCost      Decimal?       @db.Decimal(18, 6)
  status             ApprovalStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  expiresAt          DateTime?
  decidedAt          DateTime?
  decidedBy          String?
  consumedAt         DateTime?
  consumedFingerprint String?
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester          User?          @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  decider            User?          @relation("ApprovalDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, targetResourceType, targetResourceId])
  @@index([organizationId, actionFingerprint, status])
}

model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  objectiveId    String?
  currentState   String
  status         WorkflowStatus @default(PENDING)
  currentTaskId  String?
  currentJobId   String?
  startedAt      DateTime?
  updatedAt      DateTime       @updatedAt
  completedAt    DateTime?
  failureCode    String?
  failureMessage String?
  retryCount     Int            @default(0)
  resumableState Json
  metadata       Json
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  jobs           Job[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, objectiveId])
  @@index([currentTaskId])
  @@index([currentJobId])
}

model Worker {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  type            String
  status          WorkerStatus @default(ACTIVE)
  capabilities    Json
  permissionProfile Json
  metadata        Json
  createdAt       DateTime     @default(now())
  lastActivityAt  DateTime?
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credentials     WorkerCredential[]
  jobs            Job[]

  @@index([organizationId, status])
  @@index([organizationId, lastActivityAt])
}

model WorkerCredential {
  id         String   @id @default(cuid())
  workerId   String
  verifier   String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, revokedAt])
  @@index([workerId, expiresAt])
}

model Job {
  id                String    @id @default(cuid())
  organizationId    String
  objectiveId       String?
  taskId            String?
  workflowId        String?
  workerIdentityId  String?
  idempotencyKey    String?
  status            JobStatus @default(QUEUED)
  attemptNumber     Int       @default(0)
  maxAttempts       Int       @default(3)
  priority          Int       @default(0)
  workerId          String?
  leaseExpiresAt    DateTime?
  lastHeartbeatAt   DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  failureCode       String?
  failureMessage    String?
  failureRetryable  Boolean?
  nextRetryAt       DateTime?
  resumableState    Json
  metadata          Json
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  objective         Objective? @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  task              Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workflow          Workflow?  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workerIdentity    Worker?    @relation(fields: [workerIdentityId], references: [id], onDelete: SetNull)
  checkpoints       Checkpoint[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, priority, createdAt])
  @@index([organizationId, workerId, status])
  @@index([organizationId, leaseExpiresAt])
  @@index([organizationId, workerIdentityId, status])
  @@index([objectiveId, status])
  @@index([taskId, status])
  @@index([workflowId, status])
}

model Checkpoint {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String
  version        Int
  state          Json
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, version])
  @@index([organizationId, jobId, createdAt])
}
