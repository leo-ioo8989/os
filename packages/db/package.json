{
  "name": "@founder-os/db",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "types": "src/index.ts",
  "scripts": {
    "generate": "node scripts/normalize-prisma-schema.mjs && prisma generate",
    "migrate": "node scripts/normalize-prisma-schema.mjs && prisma migrate dev",
    "migrate:deploy": "node scripts/normalize-prisma-schema.mjs && prisma migrate deploy",
    "smoke": "tsx test/runtime-smoke.ts",
    "test:integration": "tsx --test test/v107-runtime.test.ts test/v108-runtime.test.ts test/v109-runtime.test.ts test/v109-concurrency.test.ts test/v109-concurrency-repeat.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test"
  },
  "dependencies": {
    "@founder-os/core": "workspace:*",
    "@prisma/client": "^6.15.0"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
